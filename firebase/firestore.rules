rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function role(roleName) {
      return signedIn() && userDoc().role == roleName;
    }

    function isStaff() {
      return role("dispatcher") || role("admin");
    }

    function isDriver() {
      return role("driver");
    }

    match /users/{userId} {
      allow read: if isSelf(userId) || isStaff();
      allow create: if isSelf(userId)
        && request.resource.data.role in ["parent", "driver"];
      allow update: if isSelf(userId)
        && request.resource.data.role == resource.data.role;
      allow delete: if false;
    }

    match /students/{studentId} {
      allow read: if isStaff()
        || (role("parent") && request.auth.uid in resource.data.parentIds)
        || isDriver();
      allow write: if isStaff();
    }

    match /routes/{routeId} {
      allow read: if signedIn();
      allow write: if isStaff();
    }

    match /routeStops/{stopId} {
      allow read: if signedIn();
      allow create, update, delete: if isStaff();
    }

    match /trips/{tripId} {
      allow read: if signedIn()
        && (isStaff() || resource.data.driverId == request.auth.uid);
      allow create: if isStaff();
      allow update: if isStaff()
        || (isDriver()
          && resource.data.driverId == request.auth.uid
          && request.resource.data.driverId == resource.data.driverId);
      allow delete: if isStaff();
    }

    match /stopEvents/{eventId} {
      allow read: if isStaff()
        || (isDriver() && resource.data.recordedBy == request.auth.uid)
        || (role("parent") && exists(
          /databases/$(database)/documents/students/$(resource.data.studentId)
        ));
      allow create: if isDriver()
        && request.resource.data.recordedBy == request.auth.uid
        && request.resource.data.type in ["pickup", "dropoff"];
      allow update, delete: if isStaff();
    }

    match /serviceAlerts/{alertId} {
      allow read: if signedIn();
      allow create, update: if isStaff();
      allow delete: if role("admin");
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
